# --- Supabase (local values printed by `npx supabase status -o env`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the Stripe webhook to write subscriptions. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Claude (Anthropic API). Without it, AI features show "not configured". ---
ANTHROPIC_API_KEY=

# --- Stripe (test mode keys while developing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
