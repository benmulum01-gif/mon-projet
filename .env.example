# --- Supabase (local values printed by `npx supabase status -o env`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Claude (Anthropic API). Without it, AI features show "not configured". ---
ANTHROPIC_API_KEY=


# --- Third-party services (public IDs). Each one loads ONLY after the visitor consents. ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
NEXT_PUBLIC_CALENDLY_URL=
# International format, digits only (e.g. 243xxxxxxxxx). A plain wa.me link: no tracker.
NEXT_PUBLIC_WHATSAPP_NUMBER=
